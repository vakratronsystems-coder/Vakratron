
/* ---------- AI tools: GPU calculator, training simulator ---------- */
main.vk .vk-calc-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 26px; }
main.vk .vk-calc-in label { display: grid; gap: 6px; margin-bottom: 14px; }
main.vk .vk-calc-in label span { font-size: 0.9rem !important; font-weight: 500 !important; color: #fff !important; }
main.vk .vk-calc-in select, main.vk .vk-calc-in input { width: 100%; background: #0a1020; border: 1px solid #334155; border-radius: 8px; color: #fff; padding: 9px 10px; font-family: inherit; font-size: 0.92rem; }
main.vk .vk-calc-in select:focus, main.vk .vk-calc-in input:focus { outline: none; border-color: var(--vk-accent); }
main.vk .vk-calc-out { background: #0a1020; border: 1px solid var(--vk-line); border-radius: 12px; padding: 20px; position: sticky; top: 100px; align-self: start; }
main.vk .vk-calc-big { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 16px; }
main.vk .vk-calc-big > div { background: var(--vk-surface); border: 1px solid var(--vk-line); border-radius: 10px; padding: 12px 14px; }
main.vk .vk-calc-big .k { display: block; font-size: 0.74rem !important; text-transform: uppercase; letter-spacing: 0.08em !important; color: var(--vk-muted) !important; }
main.vk .vk-calc-big .v { display: block; font-size: 1.25rem !important; font-weight: 700 !important; color: #fff !important; }
main.vk .vk-mem { display: grid; gap: 8px; margin-bottom: 14px; }
main.vk .vk-mem-row { display: grid; grid-template-columns: minmax(0, 1.3fr) 1fr 70px; gap: 10px; align-items: center; }
main.vk .vk-mem-row .l, main.vk .vk-mem-row .n { font-size: 0.82rem !important; color: var(--vk-muted) !important; line-height: 1.35 !important; }
main.vk .vk-mem-row .n { text-align: right; color: #fff !important; }
main.vk .vk-mem-row .b { height: 10px; background: #1e293b; border-radius: 6px; overflow: hidden; display: block; }
main.vk .vk-mem-row .b i { display: block; height: 100%; background: var(--vk-accent); border-radius: 6px; transition: width .3s; }
main.vk ul.vk-calc-notes li { font-size: 0.88rem !important; line-height: 1.55 !important; }
/* training simulator */
main.vk .vk-train-board { display: grid; gap: 10px; }
main.vk .vk-train-nodes { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
main.vk .vk-tnode { background: #0a1020; border: 1px solid #334155; border-radius: 10px; padding: 10px; transition: all .3s; }
main.vk .vk-tnode .t { display: block; font-size: 0.8rem !important; color: #cbd5e1 !important; margin-bottom: 8px; font-weight: 600 !important; }
main.vk .vk-tnode .g { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
main.vk .vk-tnode .g i { height: 16px; border-radius: 3px; background: #1e3a5f; border: 1px solid #38bdf8; transition: background .12s; }
main.vk .vk-tnode.spare { opacity: 0.45; border-style: dashed; }
main.vk .vk-tnode.spare .g i { background: transparent; border-color: #64748b; }
main.vk .vk-tnode.spare.in { opacity: 1; border-style: solid; border-color: #22c55e; }
main.vk .vk-tnode.spare.in .g i { background: #1e3a5f; border-color: #38bdf8; }
main.vk .vk-tnode.down { border-color: #ef4444; background: rgba(239, 68, 68, 0.08); }
main.vk .vk-tnode.down .g i { background: rgba(239, 68, 68, 0.25); border-color: #ef4444; }
main.vk .vk-train-board[data-phase="compute"] .vk-tnode:not(.down):not(.spare) .g i,
main.vk .vk-train-board[data-phase="compute"] .vk-tnode.spare.in .g i { background: #38bdf8; }
main.vk .vk-train-fabric, main.vk .vk-train-store { border-radius: 8px; padding: 8px 12px; text-align: center; border: 1px solid #334155; background: #0a1020; transition: all .12s; }
main.vk .vk-train-fabric span, main.vk .vk-train-store span { font-size: 0.82rem !important; color: var(--vk-muted) !important; }
main.vk .vk-train-board[data-phase="sync"] .vk-train-fabric { border-color: #C2185B; background: rgba(194, 24, 91, 0.18); }
main.vk .vk-train-board[data-phase="sync"] .vk-train-fabric span { color: #fff !important; }
main.vk .vk-train-board[data-phase="load"] .vk-train-store { border-color: #a5b4fc; background: rgba(165, 180, 252, 0.12); }
main.vk .vk-train-board.ckpt .vk-train-store { border-color: #22c55e; background: rgba(34, 197, 94, 0.2); }
main.vk .vk-train-bar { margin: 14px 0 10px; }
main.vk .vk-train-bar .p { position: relative; height: 12px; background: #1e293b; border-radius: 6px; }
main.vk .vk-train-bar .p i { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, #38bdf8, #C2185B); border-radius: 6px; transition: width .12s linear; }
main.vk .vk-train-bar .p b { position: absolute; top: -4px; width: 3px; height: 20px; background: #22c55e; border-radius: 2px; transition: left .2s; }
main.vk .vk-train-stats { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 8px; }
main.vk .vk-train-stats span { font-size: 0.86rem !important; color: var(--vk-muted) !important; }
main.vk .vk-train-ctl { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
main.vk .vk-train-ctl .vk-btn { cursor: pointer; }
main.vk .vk-train-ctl .vk-btn:disabled { opacity: .5; cursor: default; transform: none; }
main.vk .vk-train-ctl .ck { font-size: 0.88rem !important; color: var(--vk-muted) !important; display: inline-flex; gap: 8px; align-items: center; }
main.vk .vk-train-ctl select { background: #0a1020; border: 1px solid #334155; border-radius: 6px; color: #fff; padding: 6px 8px; font-family: inherit; }
main.vk .vk-train-log { background: #0a1020; border: 1px solid var(--vk-line); border-radius: 10px; padding: 12px 14px; max-height: 200px; overflow-y: auto; }
main.vk .vk-train-log p { margin: 0 0 6px !important; font-size: 0.9rem !important; line-height: 1.5 !important; }
main.vk .vk-train-log p.ok, main.vk .vk-train-log p.ok * { color: #86efac !important; }
main.vk .vk-train-log p.bad, main.vk .vk-train-log p.bad * { color: #fca5a5 !important; }
main.vk .vk-train-log p.warn, main.vk .vk-train-log p.warn * { color: #fde68a !important; }
@media (max-width: 860px) {
  main.vk .vk-calc-grid { grid-template-columns: 1fr; }
  main.vk .vk-calc-out { position: static; }
  main.vk .vk-train-nodes { grid-template-columns: repeat(3, 1fr); }
}
