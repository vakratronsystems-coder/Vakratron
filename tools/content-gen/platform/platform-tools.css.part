
/* ---------- Platform tools: K8s checker, GitOps, API simulator ---------- */
main.vk .vk-go-flow { display: grid; grid-template-columns: 1fr 70px 1fr 70px 2fr; gap: 8px; align-items: stretch; margin-bottom: 14px; }
main.vk .vk-go-flow .box, main.vk .vk-api-flow .box { background: #0a1020; border: 1px solid #334155; border-radius: 10px; padding: 12px; display: flex; flex-direction: column; gap: 4px; transition: all .2s; }
main.vk .vk-go-flow .t, main.vk .vk-api-flow .t { font-size: 0.9rem !important; font-weight: 600 !important; color: #fff !important; }
main.vk .vk-go-flow .s, main.vk .vk-api-flow .s { font-size: 0.78rem !important; color: #94a3b8 !important; }
main.vk .vk-go-flow .vv { font-size: 0.82rem !important; color: #cbd5e1 !important; margin-top: 6px; }
main.vk .vk-go-flow .vv b { color: #38bdf8 !important; font-weight: 700 !important; }
main.vk .vk-go-flow .argo.ok { border-color: #22c55e; }
main.vk .vk-go-flow .argo.warn { border-color: #f59e0b; background: rgba(245, 158, 11, 0.08); }
main.vk .vk-go-flow .argo.bad { border-color: #ef4444; background: rgba(239, 68, 68, 0.08); }
main.vk .vk-go-flow .arrow { position: relative; display: flex; align-items: center; }
main.vk .vk-go-flow .arrow::before { content: ""; flex: 1; height: 2px; background: #C2185B; }
main.vk .vk-go-flow .arrow::after { content: ""; border-left: 8px solid #C2185B; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
main.vk .vk-go-flow .arrow span { position: absolute; top: 18%; left: 0; right: 0; text-align: center; font-size: 0.72rem !important; color: #94a3b8 !important; }
main.vk .vk-go-flow .kn { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 6px; }
main.vk .vk-go-flow .node { border: 1px solid #334155; border-radius: 8px; padding: 6px; min-height: 92px; transition: all .2s; }
main.vk .vk-go-flow .node.down { border-color: #ef4444; background: rgba(239, 68, 68, 0.1); }
main.vk .vk-go-flow .node .nt { font-size: 0.72rem !important; color: #94a3b8 !important; display: block; margin-bottom: 4px; }
main.vk .vk-go-flow .pods { display: flex; flex-wrap: wrap; gap: 4px; }
main.vk .vk-go-flow .pod { font-size: 0.7rem !important; font-weight: 700 !important; padding: 3px 6px; border-radius: 5px; background: rgba(56, 189, 248, 0.2); border: 1px solid #38bdf8; color: #e0f2fe !important; transition: all .25s; }
main.vk .vk-go-flow .pod.v2, main.vk .vk-go-flow .pod.v4, main.vk .vk-go-flow .pod.v6 { background: rgba(194, 24, 91, 0.25); border-color: #C2185B; color: #fce7f3 !important; }
main.vk .vk-go-flow .pod.starting { border-style: dashed; opacity: .6; }
main.vk .vk-go-flow .pod.dead { background: rgba(239, 68, 68, 0.25); border-color: #ef4444; text-decoration: line-through; }
main.vk .vk-go-ctl { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
main.vk .vk-go-ctl .vk-btn { cursor: pointer; }
main.vk .vk-go-ctl .vk-btn:disabled { opacity: .45; cursor: default; transform: none; }
/* API simulator */
main.vk .vk-api-ctl { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; margin-bottom: 14px; }
main.vk .vk-api-ctl label { display: grid; gap: 4px; font-size: 0.85rem !important; color: var(--vk-muted) !important; min-width: 0; max-width: 100%; }
main.vk .vk-api-ctl label.tg { display: flex; gap: 8px; align-items: center; color: #fff !important; padding-bottom: 8px; }
main.vk .vk-api-ctl select { background: #0a1020; border: 1px solid #334155; border-radius: 8px; color: #fff; padding: 9px 10px; font-family: inherit; font-size: 0.9rem; width: 100%; }
main.vk .vk-api-ctl input[type=checkbox] { accent-color: #C2185B; width: 16px; height: 16px; }
main.vk .vk-api-flow { display: grid; grid-template-columns: 0.7fr 24px 1fr 24px 1fr 24px 1fr; gap: 6px; align-items: stretch; margin-bottom: 12px; }
main.vk .vk-api-flow .ar { align-self: center; height: 2px; background: #C2185B; position: relative; }
main.vk .vk-api-flow .ar::after { content: ""; position: absolute; right: -2px; top: -5px; border-left: 7px solid #C2185B; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
main.vk .vk-api-flow .box.on { border-color: #38bdf8; background: rgba(56, 189, 248, 0.15); }
main.vk .vk-api-flow .box.bad { border-color: #ef4444; background: rgba(239, 68, 68, 0.15); }
main.vk .vk-api-flow .br.open, main.vk .vk-api-flow .br.open b, main.vk .vk-api-flow .ps.bad { color: #fca5a5 !important; }
main.vk .vk-api-flow .br.halfopen, main.vk .vk-api-flow .br.halfopen b { color: #fde68a !important; }
main.vk .vk-api-flow .br.closed b { color: #86efac !important; }
main.vk .vk-api-count { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 12px; }
main.vk .vk-api-count span { font-size: 0.86rem !important; color: var(--vk-muted) !important; }
main.vk .vk-api-count b { color: #fff !important; font-weight: 700 !important; }
main.vk .vk-api-count .ok b { color: #86efac !important; } main.vk .vk-api-count .e401 b { color: #fca5a5 !important; }
main.vk .vk-api-count .e429 b, main.vk .vk-api-count .e503 b { color: #fde68a !important; }
@media (max-width: 860px) {
  main.vk .vk-go-flow { grid-template-columns: 1fr; }
  main.vk .vk-go-flow .arrow { height: 26px; justify-content: center; }
  main.vk .vk-go-flow .arrow::before { flex: none; width: 2px; height: 100%; }
  main.vk .vk-go-flow .arrow::after { display: none; }
  main.vk .vk-go-flow .arrow span { top: 4px; left: 54%; text-align: left; }
  main.vk .vk-api-flow { grid-template-columns: 1fr; }
  main.vk .vk-api-flow .ar { width: 2px; height: 16px; justify-self: center; }
  main.vk .vk-api-flow .ar::after { display: none; }
}
