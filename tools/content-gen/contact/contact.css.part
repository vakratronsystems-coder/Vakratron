/* === CONTACT PAGE === */
main.vk .vk-cf-hero { padding-bottom: 8px !important; }
main.vk .vk-cf-sec { padding-top: 10px !important; }
main.vk .vk-cf-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; align-items: start; }
main.vk .vk-cf { background: linear-gradient(135deg, #0f172a 0%, #0a1020 100%); border: 1px solid rgba(194, 24, 91, 0.28); border-radius: 18px; padding: 28px 30px 26px; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.7); }
main.vk .vk-cf-top { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; }
main.vk .vk-cf-progress { flex: 1; height: 6px; background: rgba(255,255,255,0.07); border-radius: 99px; overflow: hidden; }
main.vk .vk-cf-progress span { display: block; height: 100%; width: 25%; background: linear-gradient(90deg, #C2185B, #f472b6); border-radius: 99px; transition: width .35s ease; }
main.vk .vk-cf-count { font-size: 0.8rem !important; color: var(--vk-muted) !important; white-space: nowrap; }
main.vk .vk-cf-step { display: none; }
main.vk .vk-cf-step.on { display: block; animation: cfIn .3s ease; }
@keyframes cfIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
main.vk .vk-cf-step h2 { margin: 0 0 6px !important; font-size: 1.45rem !important; }
main.vk .vk-cf-step h3 { margin: 20px 0 10px !important; font-size: 0.8rem !important; text-transform: uppercase; letter-spacing: 0.1em; color: #94a3b8 !important; font-weight: 600 !important; }
main.vk .vk-cf-step > p.vk-muted { margin: 0 0 16px !important; }
main.vk .vk-chips { display: flex; flex-wrap: wrap; gap: 8px; }
main.vk .vk-chips-lg { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
main.vk button.vk-chip { font-family: 'Inter', sans-serif !important; font-size: 0.9rem !important; color: #cbd5e1 !important; background: rgba(255,255,255,0.03) !important; border: 1px solid rgba(255,255,255,0.12) !important; border-radius: 99px; padding: 9px 15px !important; cursor: pointer; transition: all .15s ease; line-height: 1.3; text-align: left; margin: 0 !important; box-shadow: none !important; text-transform: none !important; letter-spacing: 0 !important; width: auto !important; }
main.vk button.vk-chip:hover { border-color: rgba(194,24,91,0.6) !important; color: #fff !important; }
main.vk button.vk-chip[aria-pressed="true"] { background: rgba(194,24,91,0.16) !important; border-color: #C2185B !important; color: #fff !important; }
main.vk button.vk-chip-lg { border-radius: 12px; padding: 14px 14px !important; display: flex; gap: 12px; align-items: center; font-weight: 500 !important; }
main.vk button.vk-chip-lg i { width: 32px; height: 32px; flex: 0 0 32px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; background: rgba(56,189,248,0.1); color: #38bdf8; font-size: 0.9rem; }
main.vk button.vk-chip-lg[aria-pressed="true"] i { background: #C2185B; color: #fff; }
main.vk .vk-cf-hints { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
main.vk button.vk-hint { font-family: 'Inter', sans-serif !important; font-size: 0.8rem !important; color: #38bdf8 !important; background: rgba(56,189,248,0.07) !important; border: 1px dashed rgba(56,189,248,0.4) !important; border-radius: 8px; padding: 6px 10px !important; cursor: pointer; margin: 0 !important; width: auto !important; text-transform: none !important; letter-spacing: 0 !important; }
main.vk button.vk-hint.used { opacity: 0.45; }
main.vk .vk-cf textarea, main.vk .vk-cf input[type=text], main.vk .vk-cf input[type=email], main.vk .vk-cf input[type=tel] { width: 100%; box-sizing: border-box; background: #070d1e !important; border: 1px solid rgba(255,255,255,0.1) !important; border-radius: 10px; color: #fff !important; padding: 13px 14px !important; font-family: 'Inter', sans-serif !important; font-size: 0.95rem !important; margin-top: 6px; transition: border-color .15s; }
main.vk .vk-cf textarea { resize: vertical; min-height: 140px; line-height: 1.55; }
main.vk .vk-cf textarea:focus, main.vk .vk-cf input:focus { outline: none; border-color: #C2185B !important; box-shadow: 0 0 0 3px rgba(194,24,91,0.15); }
main.vk .vk-cf input.bad { border-color: #f43f5e !important; }
main.vk .vk-cf-small { text-align: right; font-size: 0.75rem !important; color: #64748b !important; margin-top: 4px; }
main.vk .vk-cf-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
main.vk .vk-cf-grid label { font-size: 0.85rem !important; color: #cbd5e1 !important; font-weight: 500; }
main.vk .vk-cf-grid label.wide { grid-column: 1 / -1; }
main.vk .vk-cf-summary { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 18px; }
main.vk button.vk-cf-sum { font-family: 'Inter', sans-serif !important; font-size: 0.8rem !important; color: #e2e8f0 !important; background: rgba(255,255,255,0.04) !important; border: 1px solid rgba(255,255,255,0.08) !important; border-radius: 8px; padding: 6px 10px !important; cursor: pointer; margin: 0 !important; width: auto !important; text-align: left; text-transform: none !important; letter-spacing: 0 !important; }
main.vk button.vk-cf-sum span { color: #64748b; margin-right: 6px; }
main.vk button.vk-cf-sum em { color: #f472b6; font-style: normal; margin-left: 4px; font-size: 0.75rem; }
main.vk .vk-cf-err { display: none; color: #fda4af !important; font-size: 0.88rem !important; margin: 12px 0 0 !important; }
main.vk .vk-cf-err.on { display: block; }
main.vk .vk-cf-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 26px; padding-top: 18px; border-top: 1px solid rgba(255,255,255,0.06); }
main.vk .vk-cf-nav button[hidden] { display: none !important; }
main.vk .vk-cf-nav button:disabled { opacity: 0.6; cursor: wait; }
main.vk .vk-cf-hp { position: absolute !important; left: -9999px !important; width: 1px !important; height: 1px !important; opacity: 0 !important; }
main.vk .vk-cf-done { text-align: left; }
main.vk .vk-cf-done[hidden] { display: none !important; }
main.vk .vk-cf-tick { width: 56px; height: 56px; border-radius: 50%; background: rgba(52,211,153,0.14); color: #34d399; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; font-weight: 700; margin-bottom: 14px; animation: cfIn .4s ease; }
main.vk .vk-cf-side { display: grid; gap: 14px; position: sticky; top: 100px; }
main.vk .vk-cf-side .vk-card h3 { margin-top: 0 !important; font-size: 1rem !important; }
main.vk .vk-cf-side .vk-steps { margin: 8px 0 0 !important; }
main.vk .vk-cf-side .vk-steps li { font-size: 0.88rem !important; }
@media (max-width: 900px) {
  main.vk .vk-cf-layout { grid-template-columns: 1fr; }
  main.vk .vk-cf-side { position: static; }
}
@media (max-width: 560px) {
  main.vk .vk-cf { padding: 20px 16px; border-radius: 14px; }
  main.vk .vk-cf-grid { grid-template-columns: 1fr; }
  main.vk .vk-chips-lg { grid-template-columns: 1fr; gap: 8px; }
  main.vk button.vk-chip-lg { padding: 10px 12px !important; font-size: 0.9rem !important; }
  main.vk button.vk-chip-lg i { width: 28px; height: 28px; flex-basis: 28px; }
  main.vk .vk-cf-count { font-size: 0.72rem !important; }
}
/* === END CONTACT PAGE === */
