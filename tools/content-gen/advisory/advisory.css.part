/* === ADVISORY PAGE === */
main.vk .vk-av-head { display: flex; gap: 18px; align-items: flex-start; }
main.vk .vk-av-head h2 { margin-top: 2px !important; }
main.vk .vk-av-head .vk-lead { margin-bottom: 0 !important; }
main.vk .vk-av-ic { flex: 0 0 52px; height: 52px; border-radius: 14px; background: rgba(194,24,91,0.14); color: #f472b6; display: inline-flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-top: 4px; }
main.vk .vk-av-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 6px 0 20px; }
main.vk .vk-av-grid .vk-card h3 { margin-top: 0 !important; font-size: 1.02rem !important; }
main.vk ul.vk-av-list { list-style: none !important; padding: 0 !important; margin: 10px 0 0 !important; display: grid; gap: 9px; }
main.vk ul.vk-av-list li { position: relative; padding-left: 18px !important; margin: 0 !important; color: #cbd5e1 !important; line-height: 1.55; font-size: 0.95rem !important; }
main.vk ul.vk-av-list li::before { content: '' !important; position: absolute; left: 2px; top: 0.62em; width: 6px; height: 6px; border-radius: 50%; background: #C2185B; }
main.vk ol.vk-av-steps { list-style: none !important; padding: 0 !important; margin: 10px 0 0 !important; display: grid; gap: 12px; }
main.vk ol.vk-av-steps li { display: grid; grid-template-columns: 112px 1fr; gap: 10px; margin: 0 !important; padding: 0 !important; color: #cbd5e1 !important; line-height: 1.55; font-size: 0.95rem !important; }
main.vk ol.vk-av-steps li::before { content: none !important; }
main.vk ol.vk-av-steps .w { font-weight: 600; color: #f472b6 !important; font-size: 0.85rem !important; padding-top: 2px; }
main.vk .vk-av-gets h3.vk-av-need { margin-top: 18px !important; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.07); }
main.vk .vk-av-offer:nth-of-type(odd) { background: rgba(255,255,255,0.012); }
main.vk .vk-av-sample { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; align-items: start; margin-top: 18px; }
main.vk .vk-av-doc { background: #f8fafc; color: #0f172a; border-radius: 12px; padding: 22px; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.7); transform: rotate(-0.6deg); }
main.vk .vk-av-doc * { color: #0f172a !important; }
main.vk .vk-av-doc-top { display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 0.95rem !important; border-bottom: 2px solid #C2185B; padding-bottom: 8px; margin-bottom: 10px; gap: 10px; }
main.vk .vk-av-doc-top .tag { font-size: 0.7rem !important; font-weight: 600; background: #fde68a; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
main.vk .vk-av-doc-sum { font-size: 0.85rem !important; line-height: 1.55; margin: 0 0 12px !important; }
main.vk .vk-av-doc table { width: 100%; border-collapse: collapse; font-size: 0.78rem !important; }
main.vk .vk-av-doc th { text-align: left; background: #e2e8f0 !important; padding: 6px 8px !important; font-weight: 700; border: 0 !important; }
main.vk .vk-av-doc td { padding: 6px 8px !important; border-bottom: 1px solid #e2e8f0 !important; border-left: 0 !important; border-right: 0 !important; background: transparent !important; vertical-align: top; }
main.vk .vk-av-doc .r { display: inline-block; padding: 1px 7px; border-radius: 99px; font-weight: 700; font-size: 0.7rem !important; }
main.vk .vk-av-doc .r.hi { background: #fecdd3; color: #9f1239 !important; }
main.vk .vk-av-doc .r.md { background: #fde68a; color: #92400e !important; }
main.vk .vk-av-doc .r.lo { background: #bbf7d0; color: #166534 !important; }
main.vk .vk-av-doc-notes h3 { margin-top: 0 !important; }
main.vk .vk-av-faq { display: grid; gap: 10px; margin-top: 16px; }
main.vk .vk-av-faq details { background: var(--vk-surface); border: 1px solid var(--vk-line); border-radius: 12px; padding: 14px 18px; }
main.vk .vk-av-faq summary { cursor: pointer; font-weight: 600; color: #fff !important; font-size: 1rem !important; }
main.vk .vk-av-faq details p { margin: 10px 0 0 !important; color: #cbd5e1 !important; line-height: 1.6; }
@media (max-width: 900px) {
  main.vk .vk-av-grid, main.vk .vk-av-sample { grid-template-columns: 1fr; }
  main.vk .vk-av-doc { transform: none; overflow-x: auto; }
}
@media (max-width: 560px) {
  main.vk .vk-av-head { flex-direction: column; gap: 10px; }
  main.vk ol.vk-av-steps li { grid-template-columns: 1fr; gap: 2px; }
}
/* === END ADVISORY PAGE === */
