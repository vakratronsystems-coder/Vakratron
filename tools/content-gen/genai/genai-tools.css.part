
/* ---------- GenAI tools: LLM cost, RAG flow, agent loop ---------- */
main.vk .vk-cmp { display: grid; gap: 10px; margin: 6px 0 12px; }
main.vk .vk-cmp .r { display: grid; grid-template-columns: 100px 1fr 90px; gap: 10px; align-items: center; }
main.vk .vk-cmp .l { font-size: 0.86rem !important; color: var(--vk-muted) !important; }
main.vk .vk-cmp .n { font-size: 0.95rem !important; color: #fff !important; font-weight: 600 !important; text-align: right; }
main.vk .vk-cmp .b { height: 18px; background: #1e293b; border-radius: 5px; overflow: hidden; display: block; }
main.vk .vk-cmp .b i { display: block; height: 100%; border-radius: 5px; transition: width .3s; }
main.vk .vk-warn-line { padding: 10px 12px; border-left: 3px solid #f59e0b; background: rgba(245, 158, 11, 0.1); border-radius: 0 8px 8px 0; font-size: 0.88rem !important; }
/* RAG flow */
main.vk .vk-rag-ctl { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-bottom: 16px; }
main.vk .vk-rag-ctl label { display: grid; gap: 4px; font-size: 0.85rem !important; color: var(--vk-muted) !important; }
main.vk .vk-rag-ctl select { background: #0a1020; border: 1px solid #334155; border-radius: 8px; color: #fff; padding: 9px 10px; font-family: inherit; font-size: 0.9rem; max-width: 100%; }
main.vk .vk-rag-ctl .vk-btn { cursor: pointer; }
main.vk .vk-rag-ctl .vk-btn:disabled { opacity: .5; cursor: default; transform: none; }
main.vk .vk-rag-stages { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-bottom: 16px; }
main.vk .vk-rag-stages .st { font-size: 0.82rem !important; color: #64748b; border: 1px solid #334155; border-radius: 8px; padding: 8px 10px; display: flex; align-items: center; gap: 8px; transition: all .25s; }
main.vk .vk-rag-stages .st .n { width: 20px; height: 20px; border-radius: 50%; border: 1px solid #475569; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem !important; flex: none; }
main.vk .vk-rag-stages .st.on { color: #fff; border-color: #C2185B; background: rgba(194, 24, 91, 0.15); }
main.vk .vk-rag-stages .st.done { color: #cbd5e1; border-color: #38bdf8; }
main.vk .vk-rag-stages .st.done .n { background: #38bdf8; border-color: #38bdf8; color: #020617 !important; }
main.vk .vk-rag-body { display: grid; grid-template-columns: 1fr 1.1fr; gap: 18px; }
main.vk .vk-rag-docs h4, main.vk .vk-rag-ans h4, main.vk .vk-ag-tools h4 { font-size: 0.95rem !important; margin-bottom: 10px !important; }
main.vk .vk-rag-docs .doc { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; padding: 9px 12px; border: 1px solid #334155; border-radius: 8px; margin-bottom: 6px; background: #0a1020; transition: all .25s; }
main.vk .vk-rag-docs .doc .t { font-size: 0.9rem !important; color: #e2e8f0 !important; }
main.vk .vk-rag-docs .doc .a { font-size: 0.75rem !important; color: #94a3b8 !important; border: 1px solid #334155; border-radius: 999px; padding: 0 8px; align-self: center; }
main.vk .vk-rag-docs .doc .sc { grid-column: 1 / -1; font-size: 0.75rem !important; color: #38bdf8 !important; }
main.vk .vk-rag-docs .doc.hit { border-color: #38bdf8; }
main.vk .vk-rag-docs .doc.blocked { border-color: #ef4444; background: rgba(239, 68, 68, 0.08); opacity: .7; }
main.vk .vk-rag-docs .doc.blocked .t { text-decoration: line-through; }
main.vk .vk-rag-docs .doc.stale { opacity: .5; }
main.vk .vk-rag-docs .doc.pick { border-color: #22c55e; background: rgba(34, 197, 94, 0.1); }
main.vk .vk-rag-ans .box { background: #0a1020; border: 1px solid #334155; border-radius: 10px; padding: 14px 16px; min-height: 120px; }
main.vk .vk-rag-ans .box .q { color: #94a3b8 !important; font-style: italic; }
main.vk .vk-rag-ans .cites { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
main.vk .vk-rag-ans .cites span { font-size: 0.78rem !important; color: #86efac !important; border: 1px solid rgba(34, 197, 94, 0.4); border-radius: 6px; padding: 2px 8px; }
main.vk .vk-rag-ans .note p { font-size: 0.86rem !important; margin: 8px 0 0 !important; color: #cbd5e1 !important; }
main.vk .vk-rag-ans .note p.bad { color: #fca5a5 !important; }
main.vk .vk-rag-ans .note p.warn { color: #fde68a !important; }
/* agent loop */
main.vk .vk-ag-req { background: #0a1020; border: 1px solid #334155; border-left: 3px solid #38bdf8; border-radius: 8px; padding: 12px 14px; margin-bottom: 14px; }
main.vk .vk-ag-req .k { font-size: 0.78rem !important; color: #94a3b8 !important; text-transform: uppercase; letter-spacing: .06em !important; }
main.vk .vk-ag-req p { margin: 4px 0 0 !important; }
main.vk .vk-ag-body { display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; }
main.vk .vk-ag-log { background: #0a1020; border: 1px solid var(--vk-line); border-radius: 10px; padding: 12px 14px; height: 340px; overflow-y: auto; }
main.vk .vk-ag-log p { margin: 0 0 7px !important; font-size: 0.88rem !important; line-height: 1.5 !important; }
main.vk .vk-ag-log p.plan, main.vk .vk-ag-log p.plan * { color: #c4b5fd !important; }
main.vk .vk-ag-log p.call, main.vk .vk-ag-log p.call * { color: #7dd3fc !important; }
main.vk .vk-ag-log p.res, main.vk .vk-ag-log p.res * { color: #94a3b8 !important; }
main.vk .vk-ag-log p.ok, main.vk .vk-ag-log p.ok * { color: #86efac !important; }
main.vk .vk-ag-log p.bad, main.vk .vk-ag-log p.bad * { color: #fca5a5 !important; }
main.vk .vk-ag-log p.warn, main.vk .vk-ag-log p.warn * { color: #fde68a !important; }
main.vk .vk-ag-tools .srv { display: flex; justify-content: space-between; gap: 8px; padding: 9px 12px; border: 1px solid #334155; border-radius: 8px; margin-bottom: 6px; background: #0a1020; transition: all .25s; }
main.vk .vk-ag-tools .srv .t { font-size: 0.88rem !important; color: #e2e8f0 !important; }
main.vk .vk-ag-tools .srv .p { font-size: 0.75rem !important; color: #94a3b8 !important; text-align: right; }
main.vk .vk-ag-tools .srv.on { border-color: #38bdf8; background: rgba(56, 189, 248, 0.15); }
main.vk .vk-ag-tools .srv.blockedsrv { border-style: dashed; opacity: .6; }
main.vk .vk-ag-tools .srv.deny { border-color: #ef4444; background: rgba(239, 68, 68, 0.12); opacity: 1; }
main.vk .vk-ag-ctl { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
main.vk .vk-ag-ctl .vk-btn { cursor: pointer; }
main.vk .vk-ag-ctl .vk-btn:disabled { opacity: .45; cursor: default; transform: none; }
@media (max-width: 860px) {
  main.vk .vk-rag-stages { grid-template-columns: 1fr 1fr; }
  main.vk .vk-rag-body, main.vk .vk-ag-body { grid-template-columns: 1fr; }
  main.vk .vk-ag-log { height: 280px; }
}
main.vk .vk-rag-ctl label { min-width: 0; max-width: 100%; }
main.vk .vk-rag-ctl select { width: 100%; }
